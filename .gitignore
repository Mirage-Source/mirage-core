# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
*.env

# Editor/IDE
# .idea/
# .vscode/

# SSH host keys
config/*.pem
config/*.key
config/hostkey*
config/hostkey
config/hostkey.pub

artifacts/*.pt
__pycache__/

dataset/
*.egg-info/

# local DB backups (scripts/backup_db.sh) -- never committed
backups/

data/labels/labeling_queue.jsonl

# Real-data re-ID corpus export (mirage-reid-export) -- large, derived from a
# DB backup restore, regenerate with mirage-reid-export rather than commit.
ml/data/
