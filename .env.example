# MIRAGE Environment Configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ── Database ────────────────────────────────────────────────────────────────
DB_NAME=mirage
DB_USER=mirage
DB_PASSWORD=changeme

# DB_HOST and DB_PORT are set automatically by docker-compose.
# Only override these if running services outside of Docker.
# DB_HOST=localhost
# DB_PORT=5432

# ── Bridge / ML Worker ──────────────────────────────────────────────────────
# How often the worker polls PostgreSQL for unenriched sessions (seconds).
BRIDGE_POLL_INTERVAL_S=10

# Number of sessions processed per polling batch.
BRIDGE_BATCH_SIZE=32

# ── Neural Enrichment (optional) ────────────────────────────────────────────
# Uncomment and set these to enable 128-d behavioral embeddings.
# Place trained artifacts in ./artifacts/embedder/ first.
# Without these the worker runs in degraded mode: timing + tool signatures only.
#
# MIRAGE_MODEL_CHECKPOINT=/app/artifacts/embedder/best.pt
# MIRAGE_TOKENIZER_DIR=/app/artifacts/embedder/tokenizer
# MIRAGE_MODEL_VERSION=mirage-emb-v1

# ── Adaptive Deception Policy (optional) ────────────────────────────────────
# Off by default -- the live shell behaves exactly as it does today unless
# you explicitly enable this. Recommended rollout: enable with
# MIRAGE_DECEPTION_APPLY_ACTIONS left at its default (false) first -- that's
# "shadow mode", where every command gets a real decision from the trained
# policy and it's logged to commands.deception_action, but nothing about the
# attacker's shell experience changes. Only flip APPLY_ACTIONS on once you've
# reviewed some shadow-mode decisions.
#
# Read by mirage-core (the Go SSH server):
# MIRAGE_DECEPTION_ENABLED=false
# MIRAGE_DECEPTION_URL=http://mirage-deception:8787
# MIRAGE_DECEPTION_TIMEOUT_MS=200
# MIRAGE_DECEPTION_APPLY_ACTIONS=false
#
# Read by the mirage-deception service (ml/mirage/deception/serve.py).
# Point the checkpoint at whichever policy you want live; all three trained
# checkpoints are committed under ml/mirage/deception/ and ship inside the
# image at /app/ml/mirage/deception/. ppo.pt is the strongest of the three in
# offline evaluation. To run a newer checkpoint without rebuilding the image,
# place it under ./artifacts/deception/ instead and point this there.
# MIRAGE_DECEPTION_CHECKPOINT=/app/ml/mirage/deception/ppo.pt
# MIRAGE_DECEPTION_ALGO=ppo
# MIRAGE_DECEPTION_PORT=8787
# MIRAGE_DECEPTION_MAX_STEPS=25
# MIRAGE_DECEPTION_SESSION_TTL_SECONDS=900

# ── SSH Server: Connection / Timeout Limits ─────────────────────────────────
# These aren't new -- they've always been read via os.Getenv in
# internal/server/server.go -- just documented here for the first time
# alongside TRUST_PROXY_PROTOCOL below.
#
# How long a silent, already-authenticated connection can sit idle before
# being dropped (seconds).
# SSH_IDLE_TIMEOUT_SECONDS=120
#
# How long an SSH handshake has to complete before being abandoned (seconds).
# SSH_HANDSHAKE_TIMEOUT_SECONDS=20
#
# Hard cap on simultaneous in-flight connections; a flood past this point is
# refused outright instead of risking an OOM kill.
# MAX_CONCURRENT_CONNECTIONS=500

# ── PROXY Protocol (optional) ────────────────────────────────────────────────
# Off by default. Only turn this on if Mirage sits behind something that
# forwards connections at the TCP layer (a load balancer, a relay/sensor
# node, etc.) and prepends a PROXY protocol v1 header to each one -- when
# enabled, that header's claimed source IP/port is trusted and recorded
# instead of the raw TCP peer address (conn.RemoteAddr()).
#
# NEVER enable this on a listener directly reachable from the open internet:
# anyone connecting straight to that port could hand-craft their own PROXY
# header and spoof any source IP they want, poisoning every downstream
# log/classification/re-identification signal that depends on client_ip.
# TRUST_PROXY_PROTOCOL=false

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=changeme

# Password for the read-only `grafana_ro` Postgres role (see
# internal/store/migrations/006_grafana_readonly_role.sql -- apply that
# migration by hand once, then:
#   docker compose exec postgres psql -U mirage -d mirage \
#     -c "ALTER ROLE grafana_ro PASSWORD '<same value as below>';"
GRAFANA_DB_PASSWORD=changeme
