# MIRAGE Environment Configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ── Database ────────────────────────────────────────────────────────────────
DB_NAME=mirage
DB_USER=mirage
DB_PASSWORD=changeme

# DB_HOST and DB_PORT are set automatically by docker-compose.
# Only override these if running services outside of Docker.
# DB_HOST=localhost
# DB_PORT=5432

# ── Bridge / ML Worker ──────────────────────────────────────────────────────
# How often the worker polls PostgreSQL for unenriched sessions (seconds).
BRIDGE_POLL_INTERVAL_S=10

# Number of sessions processed per polling batch.
BRIDGE_BATCH_SIZE=32

# ── Neural Enrichment (optional) ────────────────────────────────────────────
# Uncomment and set these to enable 128-d behavioral embeddings.
# Place trained artifacts in ./artifacts/embedder/ first.
# Without these the worker runs in degraded mode: timing + tool signatures only.
#
# MIRAGE_MODEL_CHECKPOINT=/app/artifacts/embedder/best.pt
# MIRAGE_TOKENIZER_DIR=/app/artifacts/embedder/tokenizer
# MIRAGE_MODEL_VERSION=mirage-emb-v1

# ── Adaptive Deception Policy (optional) ────────────────────────────────────
# Off by default -- the live shell behaves exactly as it does today unless
# you explicitly enable this. Recommended rollout: enable with
# MIRAGE_DECEPTION_APPLY_ACTIONS left at its default (false) first -- that's
# "shadow mode", where every command gets a real decision from the trained
# policy and it's logged to commands.deception_action, but nothing about the
# attacker's shell experience changes. Only flip APPLY_ACTIONS on once you've
# reviewed some shadow-mode decisions.
#
# Read by mirage-core (the Go SSH server):
# MIRAGE_DECEPTION_ENABLED=false
# MIRAGE_DECEPTION_URL=http://mirage-deception:8787
# MIRAGE_DECEPTION_TIMEOUT_MS=200
# MIRAGE_DECEPTION_APPLY_ACTIONS=false
#
# Read by the mirage-deception service (ml/mirage/deception/serve.py).
# Point the checkpoint at whichever policy you want live; all three trained
# checkpoints ship in ./artifacts/deception/. ppo.pt is the strongest of the
# three in offline evaluation.
# MIRAGE_DECEPTION_CHECKPOINT=/app/artifacts/deception/ppo.pt
# MIRAGE_DECEPTION_ALGO=ppo
# MIRAGE_DECEPTION_PORT=8787
# MIRAGE_DECEPTION_MAX_STEPS=25
# MIRAGE_DECEPTION_SESSION_TTL_SECONDS=900
